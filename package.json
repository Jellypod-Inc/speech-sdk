{
  "name": "@jellypod/speech-sdk",
  "version": "0.0.3",
  "description": "A TypeScript SDK for text-to-speech with multiple provider support",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/providers/openai/index.d.ts",
      "default": "./dist/providers/openai/index.js"
    },
    "./elevenlabs": {
      "types": "./dist/providers/elevenlabs/index.d.ts",
      "default": "./dist/providers/elevenlabs/index.js"
    },
    "./deepgram": {
      "types": "./dist/providers/deepgram/index.d.ts",
      "default": "./dist/providers/deepgram/index.js"
    },
    "./lmnt": {
      "types": "./dist/providers/lmnt/index.d.ts",
      "default": "./dist/providers/lmnt/index.js"
    },
    "./wellsaid": {
      "types": "./dist/providers/wellsaid/index.d.ts",
      "default": "./dist/providers/wellsaid/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "speech",
    "openai",
    "elevenlabs",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jellypod-Inc/speech-sdk"
  },
  "dependencies": {
    "p-retry": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "dotenv": "^17.3.1",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
