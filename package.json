{
  "name": "@speech-sdk/core",
  "version": "0.11.1",
  "description": "Universal, cross-platform text-to-speech SDK with multi-provider support.",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "default": "./dist/providers.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./pronunciations": {
      "types": "./dist/pronunciations/index.d.ts",
      "default": "./dist/pronunciations/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "speech",
    "openai",
    "elevenlabs",
    "inworld",
    "ai"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jellypod-Inc/speech-sdk"
  },
  "dependencies": {
    "@mediabunny/mp3-encoder": "^1.42.0",
    "mediabunny": "^1.40.1",
    "p-retry": "^8.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "^25.5.0",
    "dotenv": "^17.3.1",
    "typescript": "^5.8.0",
    "ultracite": "7.6.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.3"
  }
}
